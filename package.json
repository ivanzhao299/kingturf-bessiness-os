{
  "name": "kingturf-business-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "10.33.4"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kingturf/web --filter @kingturf/api dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @kingturf/database db:migrate",
    "db:status": "pnpm --filter @kingturf/database db:status",
    "db:test": "pnpm --filter @kingturf/database db:test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "pnpm audit --prod --audit-level high",
    "ci:database:guard": "NODE_ENV=test pnpm --filter @kingturf/database exec node --experimental-strip-types src/cli.ts guard-test-target",
    "ci:local": "NODE_ENV=test sh -c 'pnpm install --frozen-lockfile && pnpm format:check && pnpm ci:database:guard && pnpm db:migrate && pnpm db:status && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm security:check'"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "3.2.6"
  }
}
