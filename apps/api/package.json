{
  "name": "@kingturf/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --experimental-transform-types src/server.ts",
    "dev:fastify": "node --experimental-strip-types src/server-fastify.ts",
    "start": "node --env-file-if-exists=../../.env --experimental-transform-types dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/type-provider-zod": "^1.0.3",
    "@kingturf/config": "workspace:*",
    "@kingturf/database": "workspace:*",
    "@kingturf/domain": "workspace:*",
    "@kingturf/types": "workspace:*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
