{
  "name": "@kingturf/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @kingturf/config build && node --watch --experimental-strip-types src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@kingturf/config": "workspace:*",
    "@kingturf/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
