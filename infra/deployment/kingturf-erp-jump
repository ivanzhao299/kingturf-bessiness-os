#!/bin/sh
set -eu

OFFICE_HOST="${KINGTURF_OFFICE_HOST:-root@192.168.2.204}"
OFFICE_IDENTITY="${KINGTURF_OFFICE_IDENTITY:-/root/.ssh/kingturf-office-204}"
COMMAND="${SSH_ORIGINAL_COMMAND:-${*:-}}"

case "$COMMAND" in
  "kingturf-erp deploy "????????????????????????????????????????)
    SHA=${COMMAND#kingturf-erp deploy }
    ;;
  *)
    echo "refusing unsupported KingTurf ERP command" >&2
    exit 64
    ;;
esac

printf '%s' "$SHA" | grep -Eq '^[0-9a-f]{40}$' || exit 64
exec ssh -T -i "$OFFICE_IDENTITY" -o BatchMode=yes -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=yes "$OFFICE_HOST" "kingturf-erp-office deploy $SHA"
