FROM node:24-alpine3.23 AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.33.4 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
COPY packages/config packages/config
COPY packages/ui packages/ui
RUN pnpm --filter @kingturf/web build

FROM alpine:3.23 AS runtime

# No image-filter, XSLT, GeoIP, njs or build tooling is needed by the fixed config.
# Keep the APK database and BusyBox wget's original GET-based health command.
# GNU wget --spider changes it to HEAD, which the existing API does not accept.
RUN apk upgrade --no-cache \
    && apk add --no-cache nginx ca-certificates \
    && mkdir -p /run/nginx /var/log/nginx /usr/share/nginx/html \
    && cp /var/lib/nginx/html/50x.html /usr/share/nginx/html/50x.html \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

COPY infra/docker/nginx.preview.conf /etc/nginx/http.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
