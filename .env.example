# Safe local-development placeholders. Copy to .env and change locally as needed.
POSTGRES_DB=kingturf_dev
POSTGRES_USER=kingturf
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
API_PORT=3000
API_HOST=127.0.0.1
NODE_ENV=development
ATTACHMENT_STORAGE_ADAPTER=local
ATTACHMENT_LOCAL_DIRECTORY=.local/attachments
DATABASE_URL=postgresql://kingturf:local-development-only@localhost:5432/kingturf_dev
SESSION_SECRET=change-me
SESSION_TTL_SECONDS=28800
WEBSITE_LEAD_INGEST_SECRET=local-website-lead-secret-at-least-32-characters
PASSWORD_SALT_BYTES=16
PASSWORD_KEY_LENGTH=64
PASSWORD_SCRYPT_COST=16384
PASSWORD_SCRYPT_BLOCK_SIZE=8
PASSWORD_SCRYPT_PARALLELIZATION=1
WEB_PORT=5173

# Server-side development/preview proxy only; never use a production target.
KINGTURF_API_PROXY_TARGET=http://127.0.0.1:3000
